# Cinerian frontend env
# 1. Copia este archivo a frontend/.env
# 2. Completa los valores reales locales
# 3. Nunca subas frontend/.env al repo

# Supabase project URL
VITE_SUPABASE_URL=

# Supabase publishable / anon key
VITE_SUPABASE_ANON_KEY=

# TMDB API key
VITE_TMDB_API_KEY=

# Muestra el boton "Continuar con Apple" en el acceso.
# Ponerlo en true recien cuando el provider Apple este habilitado en
# Supabase (Authentication > Providers) y el Service ID creado en el
# Apple Developer Portal. Sin eso, el boton falla al tocarlo.
VITE_ENABLE_APPLE_AUTH=false

# Push notifications. These server-only variables belong in Vercel too; never
# expose SUPABASE_SERVICE_ROLE_KEY or ONESIGNAL_REST_API_KEY with a VITE_ prefix.
ONESIGNAL_APP_ID=47939fb0-3234-4852-a5da-1ac4ec3d4f5a
ONESIGNAL_REST_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TMDB_API_KEY=
PUBLIC_APP_URL=https://www.cinerian.app
CRON_SECRET=
