# Cinerian frontend env
# 1. Copia este archivo a frontend/.env
# 2. Completa los valores reales locales
# 3. Nunca subas frontend/.env al repo

# Supabase project URL
VITE_SUPABASE_URL=

# Supabase publishable / anon key
VITE_SUPABASE_ANON_KEY=

# TMDB API key
VITE_TMDB_API_KEY=

# Muestra el boton "Continuar con Apple" en el acceso.
# Ponerlo en true recien cuando el provider Apple este habilitado en
# Supabase (Authentication > Providers) y el Service ID creado en el
# Apple Developer Portal. Sin eso, el boton falla al tocarlo.
VITE_ENABLE_APPLE_AUTH=false
